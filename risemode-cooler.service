[Unit]
Description=Rise Mode Air Cooler - display de temperatura
After=multi-user.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/risemode-cooler
ExecStart=/usr/bin/python3 /usr/local/bin/risemode-cooler
Restart=always
RestartSec=3
# Cria /run/risemode-cooler (status.json para o painel)
RuntimeDirectory=risemode-cooler
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
